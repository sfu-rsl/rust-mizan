# docker build -f docker/Dockerfile.datasets -t mizan-datasets .
# docker run -v $(pwd)/datasets:/app/datasets mizan-datasets

ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

# Nightly and Poetry versions recovered from the April 20 dataset-builder image.
ARG RUST_NIGHTLY=nightly-2026-04-20
ARG POETRY_VERSION=2.3.4

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    git \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUST_VERSION=1.84.1

# nightly needed for `mizan-mut`
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain ${RUST_VERSION} \
    && rustup install ${RUST_NIGHTLY} \
    && rustup component add rustfmt --toolchain ${RUST_VERSION} \
    && rustup component add rustfmt --toolchain ${RUST_NIGHTLY}

RUN echo "=== Verifying Rust installation ===" \
    && rustc --version | grep -q "${RUST_VERSION}" \
    && echo "Rust stable ${RUST_VERSION}: OK" \
    && rustc +${RUST_NIGHTLY} --version \
    && echo "Rust nightly: OK" \
    && rustfmt --version \
    && echo "rustfmt (stable): OK" \
    && rustfmt +${RUST_NIGHTLY} --version \
    && echo "rustfmt (nightly): OK"

RUN pip install --no-cache-dir "poetry==${POETRY_VERSION}"

WORKDIR /app

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY mizan-mut/ ./mizan-mut/
COPY samples/ ./samples/

RUN echo "=== Building mizan-mut ===" \
    && cargo +${RUST_NIGHTLY} build --locked --release -p mizan-mut \
    && cp /app/target/release/mizan-mut /usr/local/bin/ \
    && rm -rf /app/target

RUN echo "=== Verifying mizan-mut ===" \
    && mizan-mut --help > /dev/null \
    && echo "mizan-mut: OK"

COPY mizan-cli/pyproject.toml mizan-cli/poetry.lock ./mizan-cli/

RUN echo "=== Installing mizan-cli ===" \
    && cd mizan-cli \
    && poetry config virtualenvs.create false \
    && poetry install --only main --no-root --no-interaction \
    && cd ..

COPY mizan-cli/ ./mizan-cli/
RUN cd mizan-cli && poetry install --only main --no-interaction
COPY mizan.json LICENSE README.md ./

RUN echo "=== Verifying mizan-cli ===" \
    && mizan --help > /dev/null \
    && echo "mizan CLI: OK"

RUN mkdir -p /app/datasets

COPY docker/generate-datasets.sh /app/docker/generate-datasets.sh

RUN cp /app/docker/generate-datasets.sh /app/generate-datasets.sh \
    && chmod +x /app/generate-datasets.sh

CMD ["/app/generate-datasets.sh"]
